DATABASE_URL=postgresql://usuario:clave@host:5432/axzy_central?sslmode=require
# Cadena aleatoria larga (openssl rand -base64 48)
JWT_SECRET=
PORT=4100
# Origen de la consola web (coma para varios)
WEB_ORIGIN=http://localhost:5100
# URL pública del API que se mete en el QR de activación, p. ej.
# https://central-api.axzy.dev/api/v1 (sin "/" final). Si se omite, se deriva
# de la petición (protocolo + Host).
PUBLIC_API_URL=
