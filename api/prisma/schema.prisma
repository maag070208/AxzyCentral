generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Quien administra la plataforma (tú). No hay usuarios de taquería.
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

/// Lo que vendes: la app de taquerías, CheckLab, etc. Cada cliente y cada plan es de un producto.
model Product {
  id          String   @id @default(uuid())
  /// Clave estable para el código (p. ej. `TAQUERIA`).
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  /// Última versión publicada de la app: la app la compara con la suya y avisa
  /// que hay que actualizar. Sin `latestVersionCode` no se avisa nada.
  latestVersionCode Int?
  latestVersionName String?
  /// Enlace de descarga del APK (p. ej. la carpeta de Drive).
  latestUrl         String?
  latestNotes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plan[]
  clients     Client[]
  roles       Role[]

  @@map("products")
}

/// Cómo se cobra un plan: cada mes (RECURRING) o una sola vez (ONE_TIME).
enum BillingType {
  RECURRING
  ONE_TIME
}

model Plan {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  name        String
  /// Precio mensual si `billingType` es RECURRING; precio único si es ONE_TIME.
  price       Decimal     @db.Decimal(10, 2)
  billingType BillingType @default(RECURRING)
  /// Teléfonos de cocina (dispositivos con código) que incluye; null = ilimitados.
  maxKitchens Int?
  /// Meseras conectadas a la vez a la cocina; null = ilimitadas. Lo hace cumplir la cocina.
  maxWaiters  Int?
  /// Un plan dado de baja ya no se asigna; quien lo tiene lo conserva.
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  clients     Client[]

  @@unique([productId, name])
  @@map("plans")
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

model Client {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  planId      String?
  plan        Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payments    Payment[]
  devices     Device[]
  users       ClientUser[]
  sales       Sale[]
  backups     Backup[]
  appErrors   AppError[]

  @@index([planId])
  @@index([productId])
  @@map("clients")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// Cómo se cobra un pago: por periodo mensual (RECURRING) o una sola vez (ONE_TIME).
enum PaymentKind {
  RECURRING
  ONE_TIME
}

/// Cobro. El PENDING más antiguo define hasta cuándo la app trabaja sin internet.
model Payment {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      PaymentKind   @default(RECURRING)
  /// Periodo cobrado `YYYY-MM`; nulo en los cobros únicos.
  period    String?
  /// Texto libre del cobro (p. ej. "Instalación y capacitación").
  concept   String?
  amount    Decimal       @db.Decimal(10, 2)
  dueDate   DateTime      @db.Date
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  method    String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([clientId, period])
  @@index([clientId, status, dueDate])
  @@index([clientId, kind])
  @@map("payments")
}

/// Licencia de un dispositivo del cliente (p. ej. la tablet de cocina). El código en claro solo se muestra al crearlo; aquí vive su hash.
model Device {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  /// Modelo del teléfono/tablet que se dio de alta (p. ej. "SAMSUNG SM-T290").
  model       String?
  tokenHash   String    @unique
  active      Boolean   @default(true)
  lastSeenAt  DateTime?
  /// Primera activación real desde la app (no el alta en la consola).
  activatedAt DateTime?
  /// Versión de la app que reportó por última vez (p. ej. "1.1.0 (4)").
  appVersion  String?
  createdAt   DateTime  @default(now())
  sales       Sale[]
  backup      Backup?
  appErrors   AppError[]

  @@index([clientId])
  @@map("devices")
}

/// Catálogo de roles de un producto (p. ej. ADMIN, CAJERO de TAQUERIA). Se
/// siembran en la migración; cada cliente puede dar de alta usuarios con ellos.
model Role {
  id          String           @id @default(uuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Clave estable que manda la consola y entiende la app (ADMIN, CAJERO, …).
  key         String
  name        String
  permissions Json             @default("[]")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       ClientUserRole[]

  @@unique([productId, key])
  @@map("roles")
}

/// Usuario de un cliente (el que entra a la app con el código del dispositivo).
/// `username` es único dentro del cliente y la contraseña es temporal hasta que
/// la cambia desde la app.
model ClientUser {
  id                 String           @id @default(uuid())
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  username           String
  passwordHash       String
  active             Boolean          @default(true)
  lastLoginAt        DateTime?
  mustChangePassword Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  roles              ClientUserRole[]

  @@unique([clientId, username])
  @@index([clientId])
  @@map("client_users")
}

/// Roles asignados a un usuario (N a N). Al borrar usuario o rol desaparece.
model ClientUserRole {
  userId String
  roleId String
  user   ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("client_user_roles")
}

/// Cuenta cerrada que reporta la app de cocina. Una por cuenta y dispositivo:
/// si la app la reenvía (reintento por mala señal) se reemplaza, no se duplica.
/// Montos en centavos.
model Sale {
  id            String     @id @default(uuid())
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Id de la cuenta dentro de la app.
  externalId    String
  table         String
  accountNumber Int
  openedAt      DateTime
  closedAt      DateTime?
  /// Minutos respecto a UTC de la hora del local: las métricas por hora y día van en hora local.
  utcOffsetMin  Int
  cancelled     Boolean    @default(false)
  totalCents    Int
  cashCents     Int
  transferCents Int
  persons       Int
  /// Promedio de segundos entre que la orden llega a cocina y se entrega.
  prepSeconds   Int?
  appVersion    String?
  receivedAt    DateTime   @default(now())
  lines         SaleLine[]

  @@unique([deviceId, externalId])
  @@index([clientId, openedAt])
  @@map("sales")
}

model SaleLine {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  name      String
  /// Presentación (Maíz, Harina…); vacío si no tiene.
  variant   String  @default("")
  category  String?
  qty       Int
  unitCents Int

  @@index([saleId])
  @@map("sale_lines")
}

/// Último respaldo de cada teléfono de cocina principal: su estado completo
/// (menú, cuentas abiertas y órdenes) para recuperarlo si el teléfono se pierde.
/// Uno por dispositivo (varias cocinas independientes no se pisan); cada envío lo reemplaza.
model Backup {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Cuándo se tomó en el teléfono.
  savedAt    DateTime
  appVersion String?
  state      Json
  sizeBytes  Int
  receivedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
  @@map("backups")
}

/// Falla de la app (cierre inesperado) que reporta el teléfono de cocina; las de
/// las meseras llegan a través de la cocina. Se guarda una vez por dispositivo e id.
model AppError {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Id que le puso la app (no se duplica si la reenvía).
  externalId String
  /// "cocina" o "mesero".
  source     String
  appVersion String?
  model      String?
  occurredAt DateTime
  message    String
  stack      String
  receivedAt DateTime @default(now())

  @@unique([deviceId, externalId])
  @@index([clientId, occurredAt])
  @@map("app_errors")
}
