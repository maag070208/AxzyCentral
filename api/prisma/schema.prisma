generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Quien administra la plataforma (tú). No hay usuarios de taquería.
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

/// Lo que vendes: la app de taquerías, CheckLab, etc. Cada cliente y cada plan es de un producto.
model Product {
  id          String   @id @default(uuid())
  /// Clave estable para el código (p. ej. `TAQUERIA`).
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plan[]
  clients     Client[]

  @@map("products")
}

model Plan {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  name         String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  /// Un plan dado de baja ya no se asigna; quien lo tiene lo conserva.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clients      Client[]

  @@unique([productId, name])
  @@map("plans")
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

model Client {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  planId      String?
  plan        Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payments    Payment[]
  devices     Device[]

  @@index([planId])
  @@index([productId])
  @@map("clients")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// Cobro mensual. El PENDING más antiguo define hasta cuándo la app trabaja sin internet.
model Payment {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Periodo cobrado `YYYY-MM`.
  period    String
  amount    Decimal       @db.Decimal(10, 2)
  dueDate   DateTime      @db.Date
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  method    String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([clientId, period])
  @@index([clientId, status, dueDate])
  @@map("payments")
}

/// Licencia de un dispositivo del cliente (p. ej. la tablet de cocina). El código en claro solo se muestra al crearlo; aquí vive su hash.
model Device {
  id         String    @id @default(uuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
  @@map("devices")
}
